{
	"name": "brain-atlas",
	"version": "0.3.0",
	"description": "Renders an Obsidian vault as an interactive lobed brain map.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
