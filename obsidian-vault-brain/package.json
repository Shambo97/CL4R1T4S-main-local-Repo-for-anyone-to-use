{
	"name": "vault-brain",
	"version": "1.0.0",
	"description": "Auto-organizes notes by date, auto-links your vault into a connected knowledge graph, and runs vault housekeeping scans.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"organize",
		"linking",
		"housekeeping"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.5",
		"@typescript-eslint/eslint-plugin": "^6.19.0",
		"@typescript-eslint/parser": "^6.19.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.19.11",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "^5.3.3"
	}
}
